# Start with this value only for the visual preview. Accounts and APIs return 503.
DEPLOYMENT_MODE=preview

# Set these before changing DEPLOYMENT_MODE to production.
APP_ORIGIN=https://your-separate-platform-domain.example
WEB_DATABASE_URL=postgresql://platform_app:REPLACE_ME@your-postgres-host:5432/platform
WEB_DATABASE_SSL=require
WEB_DATABASE_POOL_MAX=5
WEB_OIDC_ISSUER=https://your-identity-provider.example
WEB_OIDC_CLIENT_ID=REPLACE_ME
WEB_OIDC_CLIENT_SECRET=REPLACE_ME
WEB_STORAGE_BUCKET=platform-private-documents
WEB_STORAGE_REGION=auto
WEB_STORAGE_ENDPOINT=https://your-private-s3-compatible-endpoint.example
WEB_STORAGE_ACCESS_KEY_ID=REPLACE_ME
WEB_STORAGE_SECRET_ACCESS_KEY=REPLACE_ME
PLATFORM_ADMIN_EMAILS=

# The enterprise /v1 service is optional and uses the existing backend settings.
ENABLE_DOMAIN_BACKEND=false
# Keep write operations disabled until the existing backend contract is reconciled.
POSTGRES_OPERATIONS_ACTIONS_ENABLED=false
POSTGRES_OPERATIONS_STEP_UP_READY=false
# GoDaddy supplies PORT. Do not set it to a fixed public port.
# WEB_DATABASE_MIGRATION_URL belongs only in the migration operator's environment.
