# Add these names in GoDaddy Preview; keep the existing automatic DB_* values.
DEPLOYMENT_MODE=preview
WEB_DATABASE_DRIVER=mysql
WEB_STORAGE_DRIVER=mysql
WEB_DATABASE_POOL_MAX=5
APP_ORIGIN=https://arabexperts.net

# Initial schema setup only, in Preview. Remove after the success log.
# Preview and Publish share the database. This creates eim_ tables only.
WEB_DATABASE_SETUP=true

# Add only after creating the login provider application. Do not deploy placeholders.
# WEB_OIDC_ISSUER=https://YOUR-TENANT.eu.auth0.com/
# WEB_OIDC_CLIENT_ID=FROM_PROVIDER
# WEB_OIDC_CLIENT_SECRET=FROM_PROVIDER
# WEB_OIDC_GOOGLE_CONNECTION=google-oauth2
# WEB_OIDC_EMAIL_CONNECTION=Username-Password-Authentication

ENABLE_DOMAIN_BACKEND=false
POSTGRES_OPERATIONS_ACTIONS_ENABLED=false
POSTGRES_OPERATIONS_STEP_UP_READY=false
