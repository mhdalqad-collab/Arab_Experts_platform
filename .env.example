# Never place real secrets in this file.
APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8788
BACKEND_SHUTDOWN_TIMEOUT_MS=10000
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/eim
DATABASE_MIGRATION_URL=postgresql://migration_user:replace_me@localhost:5432/eim
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
OBJECT_STORAGE_BUCKET=eim-private-local
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_UPLOAD_BASE_URL=http://localhost:9000/eim-private-local
OBJECT_STORAGE_DOWNLOAD_BASE_URL=http://localhost:9000/eim-private-local
OBJECT_STORAGE_PROVIDER_CODE=PRIVATE_OBJECT_STORAGE
OBJECT_STORAGE_CALLBACK_TOKEN=replace_with_at_least_32_random_characters
OBJECT_STORAGE_ACCESS_KEY_ID=replace_me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_me
IDENTITY_ISSUER_URL=https://identity.example.invalid
IDENTITY_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
IDENTITY_AUDIENCE=eim-api
IDENTITY_PROVIDER_CODE=PRIMARY_OIDC
IDENTITY_CLIENT_ID=eim-local
IDENTITY_CLIENT_SECRET=replace_me
PLATFORM_ADMIN_EMAILS=
POSTGRES_OPERATIONS_API_URL=http://localhost:8788
POSTGRES_OPERATIONS_API_TOKEN=replace_me
POSTGRES_OPERATIONS_ACTIONS_ENABLED=false
POSTGRES_OPERATIONS_STEP_UP_READY=false
EMAIL_PROVIDER_API_KEY=replace_me
PAYMENT_PROVIDER_SECRET=replace_me
PAYMENT_WEBHOOK_SECRET=replace_me
SIGNATURE_PROVIDER_SECRET=replace_me
MALWARE_SCANNER_URL=http://localhost:8090
MALWARE_SCANNER_TOKEN=replace_me
