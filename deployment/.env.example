APP_ENV=production
POSTGRES_DB=eim
POSTGRES_USER=eim_owner
POSTGRES_PASSWORD=replace_with_a_long_random_database_password
BACKEND_PUBLIC_PORT=8788
FRONTEND_PUBLIC_PORT=3000
DATABASE_SSL=disable
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
BACKEND_SHUTDOWN_TIMEOUT_MS=10000
IDENTITY_ISSUER_URL=https://identity.example.invalid
IDENTITY_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
IDENTITY_AUDIENCE=eim-api
IDENTITY_PROVIDER_CODE=PRIMARY_OIDC
OBJECT_STORAGE_UPLOAD_BASE_URL=https://storage.example.invalid/eim-private
OBJECT_STORAGE_DOWNLOAD_BASE_URL=https://storage.example.invalid/eim-private
OBJECT_STORAGE_PROVIDER_CODE=PRIVATE_OBJECT_STORAGE
OBJECT_STORAGE_CALLBACK_TOKEN=replace_with_at_least_32_random_characters
MALWARE_SCANNER_TOKEN=replace_with_at_least_32_random_characters
NOTIFICATION_DISPATCHER_TOKEN=replace_with_at_least_32_random_characters
POSTGRES_OPERATIONS_API_TOKEN=replace_with_at_least_32_random_characters
POSTGRES_OPERATIONS_ACTIONS_ENABLED=false
POSTGRES_OPERATIONS_STEP_UP_READY=false
