limit_req_zone $binary_remote_addr zone=eim_api:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=eim_conn:10m;

upstream eim_frontend { server frontend:3000; keepalive 32; }
upstream eim_backend { server backend:8788; keepalive 32; }

server {
  listen 80;
  server_name ${EIM_HOSTNAME};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name ${EIM_HOSTNAME};
  server_tokens off;

  ssl_certificate /etc/nginx/tls/fullchain.pem;
  ssl_certificate_key /etc/nginx/tls/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache shared:EIMTLS:10m;
  ssl_session_tickets off;

  client_max_body_size 11m;
  limit_conn eim_conn 30;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  location /internal/ { return 404; }

  location /v1/ {
    limit_req zone=eim_api burst=40 nodelay;
    proxy_pass http://eim_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
  }

  location = /backend-health {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    proxy_pass http://eim_backend/health/ready;
  }

  location / {
    proxy_pass http://eim_frontend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
  }
}
